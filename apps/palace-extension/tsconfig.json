{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "types": ["chrome", "vite/client", "vitest/globals", "node"]
  },
  "include": [
    "src",
    "e2e",
    "vite.config.ts",
    "vite.content.config.ts",
    "playwright.config.ts"
  ]
}
