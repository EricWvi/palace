{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "palace",
  "homepage": "http://127.0.0.1:5173",
  "items": [
    {
      "name": "palace-style",
      "type": "registry:style",
      "extends": "none",
      "title": "Palace",
      "description": "Warm paper surfaces, olive accents, and source-owned accessible components. Import src/theme.css after Tailwind.",
      "dependencies": [
        "cn",
        "class-variance-authority",
        "radix-ui",
        "lucide-react",
        "react-day-picker",
        "date-fns"
      ],
      "files": [
        {
          "path": "src/components/ui/popover.tsx",
          "type": "registry:ui"
        },
        {
          "path": "src/components/ui/label.tsx",
          "type": "registry:ui"
        },
        {
          "path": "src/components/ui/button.tsx",
          "type": "registry:ui"
        },
        {
          "path": "src/components/ui/calendar.tsx",
          "type": "registry:ui"
        },
        {
          "path": "src/components/ui/input.tsx",
          "type": "registry:ui"
        },
        {
          "path": "src/components/ui/dialog.tsx",
          "type": "registry:ui"
        },
        {
          "path": "src/theme.css",
          "type": "registry:file",
          "target": "src/theme.css"
        }
      ],
      "cssVars": {
        "light": {
          "background": "#fffefa",
          "foreground": "#292c25",
          "primary": "#546b40",
          "primary-foreground": "#fffefa",
          "secondary": "#efeee7",
          "muted-foreground": "#777a70",
          "accent": "#e8eddf",
          "border": "#e3e4db"
        }
      }
    }
  ]
}
