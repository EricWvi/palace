{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "palace",
  "homepage": "http://127.0.0.1:5173",
  "items": [
    {
      "name": "palace-style",
      "type": "registry:style",
      "extends": "none",
      "title": "Palace",
      "description": "Palace prototype style: warm paper, rust accent, text-first components. Colors, fonts and radii come from tokens.css (design/tokens.css); import it, then theme.css, after Tailwind.",
      "dependencies": [
        "cn",
        "class-variance-authority",
        "radix-ui",
        "lucide-react",
        "react-day-picker",
        "date-fns"
      ],
      "files": [
        {
          "path": "src/components/ui/popover.tsx",
          "type": "registry:ui"
        },
        {
          "path": "src/components/ui/label.tsx",
          "type": "registry:ui"
        },
        {
          "path": "src/components/ui/button.tsx",
          "type": "registry:ui"
        },
        {
          "path": "src/components/ui/calendar.tsx",
          "type": "registry:ui"
        },
        {
          "path": "src/components/ui/input.tsx",
          "type": "registry:ui"
        },
        {
          "path": "src/components/ui/dialog.tsx",
          "type": "registry:ui"
        },
        {
          "path": "../../design/tokens.css",
          "type": "registry:file",
          "target": "src/tokens.css"
        },
        {
          "path": "src/theme.css",
          "type": "registry:file",
          "target": "src/theme.css"
        }
      ]
    }
  ]
}
