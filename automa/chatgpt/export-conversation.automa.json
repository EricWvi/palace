                "data": {
                    "code": "const id = automaRefData(\n  \"variables\",\n  \"currentTurnId\"\n);\n\nif (!id) {\n  throw new Error(\n    \"当前 turn 缺少 data-turn-key\"\n  );\n}\n\nconst seenTurnIds = automaRefData(\n  \"variables\",\n  \"seenTurnIds\"\n) || [];\n\n// 虚拟列表重新挂载的节点没有 Automa 的循环标记，只能按稳定 ID 跳过\nconst skip = seenTurnIds.includes(id);\n\n// 本轮任何失败都会中止整个工作流，因此进入处理时即可记为已导出\nif (!skip) {\n  seenTurnIds.push(id);\n}\n\nautomaSetVariable(\"seenTurnIds\", seenTurnIds);\nautomaSetVariable(\n  \"currentTurnSkip\",\n  skip ? \"yes\" : \"no\"\n);\nautomaSetVariable(\"currentMessageRole\", \"\");\nautomaSetVariable(\"turnMessageCount\", 0);\n\nconsole.log(\n  \"[ChatGPT export] next turn\",\n  {\n    id,\n    skip\n  }\n);",
                    "context": "background",
                    "description": "检查 turn 是否已导出（后台）",
