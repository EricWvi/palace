            {
                "data": {
                    "code": "const PENDING_CLIPBOARD =\n  \"__palace_chatgpt_export_pending__\";\n\nconst id = automaRefData(\n  \"variables\",\n  \"currentTurnId\"\n);\n\nconst role = automaRefData(\n  \"variables\",\n  \"currentMessageRole\"\n);\n\nconst content = automaRefData(\n  \"variables\",\n  \"currentCopiedText\"\n);\n\nif (role !== \"user\" && role !== \"assistant\") {\n  throw new Error(\n    `无法识别消息角色: ${role}`\n  );\n}\n\n// 剪贴板仍是占位文本，说明点击没有触发新的复制\nif (\n  typeof content !== \"string\" ||\n  content.length === 0 ||\n  content === PENDING_CLIPBOARD\n) {\n  throw new Error(\n    \"本轮没有从剪贴板读到新的复制内容\"\n  );\n}\n\nconst conversation = automaRefData(\n  \"variables\",\n  \"conversation\"\n) || [];\n\nconst turnMessageCount = automaRefData(\n  \"variables\",\n  \"turnMessageCount\"\n) || 0;\n\nconversation.push({\n  role,\n  content,\n  turnId: id\n});\n\nautomaSetVariable(\"conversation\", conversation);\nautomaSetVariable(\n  \"turnMessageCount\",\n  turnMessageCount + 1\n);\n\nconsole.log(\n  \"[ChatGPT export] consumed\",\n  {\n    id,\n    role,\n    contentLength: content.length,\n    total: conversation.length\n  }\n);",
                    "context": "background",
                    "description": "追加消息（后台）",
