                "data": {
                    "disableBlock": false,
                    "description": "拦截剪切板",
                    "timeout": 20000,
                    "context": "website",
                    "code": "const preview = text =>\n  text.length > 30 ? text.slice(0, 30) + \"…\" : text;\n\nwindow.__geminiCopiedText = null;\nwindow.__geminiCopySeq = 0;\nwindow.__geminiLastReadSeq = 0;\n\n// 避免重复安装\nif (!window.__geminiClipboardInstalled) {\n  window.__geminiClipboardInstalled = true;\n\n  const clipboard = navigator.clipboard;\n\n  // Prompt 通常走 writeText\n  if (clipboard?.writeText) {\n    clipboard.writeText = async function (text) {\n      window.__geminiCopiedText = text;\n      window.__geminiCopySeq++;\n\n      console.log(\n        \"[Gemini export] writeText:\",\n        window.__geminiCopySeq,\n        preview(text)\n      );\n\n      // 不真正写入系统剪贴板\n      return;\n    };\n  }\n\n  // Response 可能走 write\n  if (clipboard?.write) {\n    clipboard.write = async function (items) {\n      console.log(\n        \"[Gemini export] write() called\",\n        items.length\n      );\n\n      for (const item of items) {\n        if (!item.types?.includes(\"text/plain\")) {\n          continue;\n        }\n\n        const blob =\n          await item.getType(\"text/plain\");\n\n        const text =\n          await blob.text();\n\n        window.__geminiCopiedText = text;\n        window.__geminiCopySeq++;\n\n        console.log(\n          \"[Gemini export] write:\",\n          window.__geminiCopySeq,\n          preview(text)\n        );\n\n        return;\n      }\n\n      console.warn(\n        \"[Gemini export] write() 中没有 text/plain\"\n      );\n    };\n  }\n}\n\nconsole.log(\n  \"[Gemini export] clipboard interceptor ready\"\n);",
                    "preloadScripts": [],
                    "everyNewTab": false,
                    "runBeforeLoad": false
                },
                "label": "javascript-code"
            },
            {
                "id": "i6mlj2r",
                "type": "BlockBasic",
                "initialized": false,
                "position": {
                    "x": 3080,
                    "y": 102.5
                },
                "data": {
                    "disableBlock": false,
                    "description": "",
                    "timeout": 20000,
                    "context": "website",
                    "code": "const seq =\n  window.__geminiCopySeq || 0;\n\nconst lastSeq =\n  window.__geminiLastReadSeq || 0;\n\nconst text =\n  window.__geminiCopiedText;\n\nif (seq <= lastSeq) {\n  throw new Error(\n    `本轮没有捕获到新的复制内容: seq=${seq}, lastSeq=${lastSeq}`\n  );\n}\n\nif (typeof text !== \"string\") {\n  throw new Error(\"捕获到的复制内容不是字符串\");\n}\n\nconst loopData =\n  automaRefData(\"loopData\", \"PZypES\");\n\nconst selector = loopData?.data;\n\nif (!selector) {\n  throw new Error(\"无法获取当前 loop selector\");\n}\n\nconst element =\n  document.querySelector(selector);\n\nif (!element) {\n  throw new Error(\n    `找不到当前 loop 元素: ${selector}`\n  );\n}\n\nlet role;\n\nif (\n  element.matches(\"user-query\") ||\n  element.querySelector(\"user-query\")\n) {\n  role = \"user\";\n} else if (\n  element.matches(\"model-response\") ||\n  element.querySelector(\"model-response\")\n) {\n  role = \"assistant\";\n} else {\n  throw new Error(\n    `无法识别消息类型: ${element.tagName}`\n  );\n}\n\nwindow.__geminiLastReadSeq = seq;\n\nconst conversation =\n  automaRefData(\n    \"variables\",\n    \"conversation\"\n  ) || [];\n\nconversation.push({\n  role,\n  content: text\n});\n\nautomaSetVariable(\n  \"conversation\",\n  conversation\n);\n\nautomaSetVariable(\n  \"currentMessage\",\n  {\n    role,\n    content: text\n  }\n);\n\nconsole.log(\n  \"[Gemini export] consumed\",\n  {\n    index: conversation.length - 1,\n    role,\n    seq\n  }\n);",
                    "preloadScripts": [],
                    "everyNewTab": false,
                    "runBeforeLoad": false
                },
                "label": "javascript-code"
            },
