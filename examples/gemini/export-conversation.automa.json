                    "code": "const loopData =\n  automaRefData(\"loopData\", \"PZypES\");\n\nif (!loopData) {\n  throw new Error(\"无法获取当前 loopData\");\n}\n\nconst selector = loopData.data;\n\nif (!selector) {\n  throw new Error(\n    \"当前 loopData 中没有 data selector\"\n  );\n}\n\nconsole.log(\n  \"[Gemini export] assistant selector:\",\n  selector\n);\n\nconst button = document.querySelector(\n  `${selector} button[aria-label=\"Copy\"], ` +\n  `${selector} button[aria-label=\"复制回答\"]`\n);\n\nif (!button) {\n  throw new Error(\n    `找不到 Assistant Copy 按钮: ${selector}`\n  );\n}\n\nconsole.log(\n  \"[Gemini export] assistant click\",\n  {\n    focused: document.hasFocus(),\n    selector\n  }\n);\n\nbutton.click();",
